<?xml version="1.0" encoding="UTF-8"?>
<project root="true"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.1.0</modelVersion>

  <groupId>io.github.huahill</groupId>
  <artifactId>coaming</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>coaming</name>
  <description>Linux OCI container runtime. Java 25 is the body. Rust runs only before the JVM.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <junit.version>5.12.2</junit.version>
    <graalvm.distribution>GraalVM CE 25.4.4.1.1</graalvm.distribution>
    <native.maven.plugin.version>0.11.1</native.maven.plugin.version>
    <nsexec.target>${project.basedir}/native/nsexec/target</nsexec.target>
    <nsexec.lib>${nsexec.target}/release/libcoaming_nsexec.a</nsexec.lib>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.1</version>
            <executions>
              <execution>
                <id>build-nsexec</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>cargo</executable>
                  <environmentVariables>
                    <CARGO_TARGET_DIR>${nsexec.target}</CARGO_TARGET_DIR>
                  </environmentVariables>
                  <arguments>
                    <argument>build</argument>
                    <argument>--release</argument>
                    <argument>--manifest-path</argument>
                    <argument>${project.basedir}/native/nsexec/Cargo.toml</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <version>${native.maven.plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <imageName>coaming</imageName>
              <mainClass>io.github.huahill.coaming.ProbeMain</mainClass>
            </configuration>
            <executions>
              <execution>
                <id>build-native</id>
                <phase>package</phase>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>nsexec-linux</id>
      <activation>
        <os>
          <name>Linux</name>
        </os>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <configuration>
              <buildArgs combine.children="append">
                <buildArg>-H:NativeLinkerOption=-Wl,--whole-archive</buildArg>
                <buildArg>-H:NativeLinkerOption=${nsexec.lib}</buildArg>
                <buildArg>-H:NativeLinkerOption=-Wl,--no-whole-archive</buildArg>
              </buildArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>nsexec-mac</id>
      <activation>
        <os>
          <family>mac</family>
        </os>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <configuration>
              <buildArgs combine.children="append">
                <buildArg>-H:NativeLinkerOption=${nsexec.lib}</buildArg>
              </buildArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
